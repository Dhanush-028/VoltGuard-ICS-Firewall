/* dark_theme.qss
 *
 * Week 4 "Refine & Polish": rugged, high-contrast dark theme for a
 * factory-floor operator display. Big touch targets, high-contrast
 * status colors, no fine print.
 *
 * Apply in your Qt main() with:
 *   QFile styleFile(":/dark_theme.qss");
 *   styleFile.open(QFile::ReadOnly);
 *   qApp->setStyleSheet(styleFile.readAll());
 */

QWidget {
    background-color: #1a1d21;
    color: #e6e6e6;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 16px;
}

QMainWindow, QDialog {
    background-color: #14161a;
}

QLabel {
    color: #e6e6e6;
}

QLabel#statusSafe {
    color: #4ade80;
    font-weight: bold;
    font-size: 20px;
}

QLabel#statusAlarm {
    color: #f87171;
    font-weight: bold;
    font-size: 20px;
    background-color: #3a1414;
    border: 2px solid #f87171;
    border-radius: 6px;
    padding: 8px;
}

QPushButton {
    background-color: #2a2e35;
    color: #e6e6e6;
    border: 1px solid #444a54;
    border-radius: 6px;
    padding: 14px 24px;      /* large touch target for gloved hands */
    min-height: 44px;
    font-size: 18px;
}

QPushButton:hover {
    background-color: #353a42;
}

QPushButton:pressed {
    background-color: #1f2329;
}

QPushButton#emergencyStop {
    background-color: #b91c1c;
    color: #ffffff;
    font-weight: bold;
    font-size: 22px;
    min-height: 64px;
    border: 2px solid #7f1d1d;
}

QPushButton#emergencyStop:hover {
    background-color: #dc2626;
}

QTabWidget::pane {
    border: 1px solid #2a2e35;
}

QTabBar::tab {
    background: #1a1d21;
    color: #b0b0b0;
    padding: 12px 20px;
    font-size: 16px;
}

QTabBar::tab:selected {
    background: #2a2e35;
    color: #ffffff;
    border-bottom: 3px solid #4ade80;
}

QGroupBox {
    border: 1px solid #2a2e35;
    border-radius: 6px;
    margin-top: 12px;
    font-size: 16px;
    color: #b0b0b0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
}

/* Charts area (used by PhysicsGraphWidget) should read clearly under
   factory lighting -- dark background, bright plotted lines. */
QChartView {
    background-color: #14161a;
}